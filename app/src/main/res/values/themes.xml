<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CookBook" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/olive</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="ButtonOlive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/olive</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ButtonBrown" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brown</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ButtonLight" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/paper_dark</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Theme.CookBook.Splash" parent="Theme.CookBook" />

</resources>
