<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/brown"
                android:textSize="@dimen/text_recipe_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/filter_side"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/filter_side"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="@dimen/segment_gap">

        <TextView
            android:id="@+id/chipAny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_min"
            android:paddingTop="@dimen/segment_pad_v"
            android:paddingBottom="@dimen/segment_pad_v"
            android:text="@string/chip_any"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/chip30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_min"
            android:paddingTop="@dimen/segment_pad_v"
            android:paddingBottom="@dimen/segment_pad_v"
            android:text="@string/chip_30"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/chip60"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_min"
            android:paddingTop="@dimen/segment_pad_v"
            android:paddingBottom="@dimen/segment_pad_v"
            android:text="@string/chip_60"
            android:textSize="@dimen/text_subtitle" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/margin_large"
        android:text="@string/list_empty"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_normal"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/list_gap"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

</LinearLayout>